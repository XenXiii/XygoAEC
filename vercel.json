{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "cleanUrls": true,
  "functions": {
    "api/web.js": {
      "includeFiles": "apps/web/public/**"
    }
  },
  "rewrites": [
    { "source": "/v1/(.*)", "destination": "/api/backend" },
    { "source": "/webhooks/email", "destination": "/api/backend" },
    { "source": "/health", "destination": "/api/backend" },
    { "source": "/ready", "destination": "/api/backend" },
    { "source": "/metrics", "destination": "/api/backend" },
    { "source": "/(.*)", "destination": "/api/web" }
  ],
  "headers": [
    {
      "source": "/runtime-config.json",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
