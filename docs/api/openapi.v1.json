{
  "openapi": "3.1.0",
  "info": {
    "title": "Xygo Staged API",
    "version": "0.1.0-staged"
  },
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error", "message", "staged"],
        "properties": {
          "error": { "type": "string" },
          "message": { "type": "string" },
          "staged": { "type": "boolean" }
        }
      },
      "Project": {
        "type": "object",
        "required": ["id", "tenantId", "name", "status", "staged"],
        "properties": {
          "id": { "type": "string" },
          "tenantId": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string" },
          "staged": { "type": "boolean" }
        }
      },
      "AuditEvent": {
        "type": "object",
        "required": ["eventId", "tenantId", "action", "resourceType", "resourceId", "eventHash", "staged"],
        "properties": {
          "eventId": { "type": "string" },
          "tenantId": { "type": "string" },
          "actorType": { "type": "string" },
          "actorId": { "type": "string" },
          "action": { "type": "string" },
          "resourceType": { "type": "string" },
          "resourceId": { "type": "string" },
          "beforeStateRef": { "type": ["string", "null"] },
          "afterStateRef": { "type": ["string", "null"] },
          "previousHash": { "type": ["string", "null"] },
          "eventHash": { "type": "string" },
          "timestamp": { "type": "string" },
          "staged": { "type": "boolean" }
        }
      },
      "AuditVerificationReport": {
        "type": "object",
        "required": ["valid", "checkedEventCount", "staged"],
        "properties": {
          "valid": { "type": "boolean" },
          "reason": { "type": ["string", "null"] },
          "eventId": { "type": ["string", "null"] },
          "checkedEventCount": { "type": "integer" },
          "staged": { "type": "boolean" }
        }
      }
    },
    "securitySchemes": {
      "stagedTenantHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "x-staged-tenant-id",
        "description": "Self-asserted staged tenant scope. Must equal the {tenantId} path segment or the request is rejected with 403. STAGED ONLY: this is not authenticated and must be replaced with real tenant authn/authz before production."
      },
      "stagedTenantQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "stagedTenantId",
        "description": "Query-param equivalent of x-staged-tenant-id for the SSE stream, where EventSource cannot set request headers. Same staged, unauthenticated scope semantics."
      },
      "stagedUserHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "x-staged-user-id",
        "description": "Optional synthetic actor id recorded on audit events. Defaults to \"synthetic-user\" when omitted."
      }
    },
    "parameters": {
      "PaginationLimit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Max items per page (default 50, max 500). Applies to all list endpoints.",
        "schema": { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 }
      },
      "PaginationOffset": {
        "name": "offset",
        "in": "query",
        "required": false,
        "description": "Zero-based offset into the result set. Applies to all list endpoints.",
        "schema": { "type": "integer", "minimum": 0, "default": 0 }
      },
      "StatusFilter": {
        "name": "status",
        "in": "query",
        "required": false,
        "description": "Filter list results by status / humanDisposition. Applies to all list endpoints.",
        "schema": { "type": "string" }
      }
    }
  },
  "security": [
    { "stagedTenantHeader": [] }
  ],
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Local staged server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Staged health check",
        "security": [],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/v1/tenants/{tenantId}/projects": {
      "get": {
        "summary": "List staged projects for a tenant",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          { "$ref": "#/components/parameters/PaginationLimit" },
          { "$ref": "#/components/parameters/PaginationOffset" },
          { "$ref": "#/components/parameters/StatusFilter" }
        ],
        "responses": {
          "200": {
            "description": "project list (paginated: items + pagination block)"
          },
          "403": {
            "description": "tenant mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tenants/{tenantId}/dashboard/executive": {
      "get": {
        "summary": "Return staged executive dashboard summary",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "executive summary"
          }
        }
      }
    },
    "/v1/tenants/{tenantId}/blueprint-workspace": {
      "get": {
        "summary": "Return the staged blueprint workspace (packages, sheets, review runs, findings)",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "staged blueprint workspace view"
          },
          "403": {
            "description": "tenant mismatch or unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tenants/{tenantId}/platform-blueprints": {
      "get": {
        "summary": "List staged business platform blueprints for a tenant",
        "parameters": [
          { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/PaginationLimit" },
          { "$ref": "#/components/parameters/PaginationOffset" },
          { "$ref": "#/components/parameters/StatusFilter" }
        ],
        "responses": {
          "200": { "description": "paginated blueprint list (items + pagination block)" },
          "403": { "description": "tenant mismatch or unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      },
      "post": {
        "summary": "Create a staged business platform blueprint (deterministic generation, no live AI)",
        "parameters": [
          { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "201": { "description": "generated blueprint" },
          "400": { "description": "validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "403": { "description": "tenant mismatch or unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/v1/tenants/{tenantId}/platform-blueprints/{blueprintId}": {
      "get": {
        "summary": "Read a single staged business platform blueprint",
        "parameters": [
          { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "blueprintId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "blueprint" },
          "404": { "description": "not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/v1/tenants/{tenantId}/field-reports": {
      "get": {
        "summary": "List staged field reports for a tenant",
        "parameters": [
          { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/PaginationLimit" },
          { "$ref": "#/components/parameters/PaginationOffset" },
          { "$ref": "#/components/parameters/StatusFilter" }
        ],
        "responses": {
          "200": { "description": "paginated field report list" },
          "403": { "description": "tenant mismatch or unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      },
      "post": {
        "summary": "Capture a staged field report (photos/notes/checklist/voice placeholders)",
        "parameters": [ { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": {
          "201": { "description": "captured field report" },
          "400": { "description": "validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/v1/tenants/{tenantId}/field-reports/{reportId}": {
      "get": {
        "summary": "Read a single staged field report",
        "parameters": [
          { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "reportId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "field report" },
          "404": { "description": "not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/v1/tenants/{tenantId}/field-reports/{reportId}/draft": {
      "post": {
        "summary": "Generate a staged AI report draft (deterministic simulation, no live AI)",
        "parameters": [
          { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "reportId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "report with generated draft" },
          "404": { "description": "not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/v1/tenants/{tenantId}/field-reports/{reportId}/review": {
      "post": {
        "summary": "Set the human review status of a staged field report (approve gates client visibility)",
        "parameters": [
          { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "reportId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "reviewed report" },
          "400": { "description": "validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "404": { "description": "not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/v1/tenants/{tenantId}/files": {
      "get": {
        "summary": "List tenant-scoped file metadata without object-storage keys",
        "parameters": [ { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": {
          "200": { "description": "tenant file metadata" },
          "403": { "description": "tenant mismatch or unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/v1/tenants/{tenantId}/files/upload-intents": {
      "post": {
        "summary": "Validate file metadata and create a controlled local or presigned object-storage upload target",
        "parameters": [ { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": {
          "201": { "description": "pending file metadata and upload target" },
          "400": { "description": "unsafe MIME, size, filename, or association", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "403": { "description": "tenant mismatch or unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/v1/tenants/{tenantId}/files/{fileId}": {
      "delete": {
        "summary": "Delete tenant-scoped object bytes and retain soft-deleted audit metadata",
        "parameters": [
          { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "fileId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "soft-deleted file metadata" },
          "403": { "description": "tenant mismatch or unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "404": { "description": "not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/v1/tenants/{tenantId}/files/{fileId}/complete": {
      "post": {
        "summary": "Verify uploaded object tenant/type/size and atomically persist ready metadata plus audit evidence",
        "parameters": [
          { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "fileId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "completed file metadata" },
          "400": { "description": "object is absent or does not match the upload intent", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "404": { "description": "not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/v1/tenants/{tenantId}/files/{fileId}/download": {
      "get": {
        "summary": "Create a short-lived signed download target or authenticated local proxy target",
        "parameters": [
          { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "fileId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "controlled download target" },
          "403": { "description": "tenant mismatch or unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "404": { "description": "not found or not client-visible", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/v1/tenants/{tenantId}/files/{fileId}/content": {
      "get": {
        "summary": "Read file bytes through the authenticated local-development proxy only",
        "parameters": [
          { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "fileId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "file bytes" }, "404": { "description": "not found or object-storage mode" } }
      },
      "put": {
        "summary": "Upload file bytes through the authenticated local-development proxy only",
        "parameters": [
          { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "fileId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "completed local file metadata" }, "400": { "description": "invalid bytes or object-storage mode" } }
      }
    },
    "/v1/tenants/{tenantId}/client-portal": {
      "get": {
        "summary": "Read the staged client-facing portal (approved reports, files, updates, staged payment placeholder)",
        "parameters": [ { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": {
          "200": { "description": "per-project client portal views" },
          "403": { "description": "tenant mismatch or unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
