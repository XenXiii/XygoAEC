    "/v1/tenants/{tenantId}/events/stream": {
      "get": {
        "summary": "Open staged tenant event stream",
        "security": [
          { "stagedTenantQuery": [] }
        ],
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stagedTenantId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
