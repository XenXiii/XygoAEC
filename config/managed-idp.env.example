# Provider-neutral managed OIDC reference fragment. Values are examples only.
# This is not the complete production manifest. Start production configuration from
# config/production.env.example and keep actual values in the approved secret store.
NODE_ENV=production
STAGED_MODE=false
XYGO_AUTH_MODE=oidc
XYGO_OIDC_PROVIDER=other-managed-oidc
XYGO_OIDC_ISSUER=https://tenant.example-idp.com/
XYGO_OIDC_AUDIENCE=https://api.xygo.example
XYGO_OIDC_JWKS_URI=https://tenant.example-idp.com/.well-known/jwks.json
XYGO_OIDC_ALLOWED_ALGORITHMS=RS256
XYGO_OIDC_CLOCK_TOLERANCE_SEC=60

# API runtime (connection string is a secret; never put a real value here).
XYGO_API_REPOSITORY_MODE=postgres
XYGO_API_PG_URL=<secret-postgres-url>

# Browser public-client settings. Do not configure a client secret.
XYGO_WEB_APP_URL=https://app.xygo.example
XYGO_WEB_API_BASE_URL=https://api.xygo.example
XYGO_WEB_OIDC_CLIENT_ID=<public-client-id>
XYGO_WEB_OIDC_AUTHORIZATION_ENDPOINT=https://tenant.example-idp.com/authorize
XYGO_WEB_OIDC_TOKEN_ENDPOINT=https://tenant.example-idp.com/oauth/token
XYGO_WEB_OIDC_END_SESSION_ENDPOINT=https://tenant.example-idp.com/logout
XYGO_WEB_OIDC_SCOPES=openid profile email
