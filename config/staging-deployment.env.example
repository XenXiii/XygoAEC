# Deployment-control inputs for `npm run check:staging`.
# This is deliberately incomplete and non-deployable. Supply the full production contract from
# config/production.env.example through the approved configuration and secret managers.
XYGO_DEPLOY_ENVIRONMENT=staging
XYGO_STAGING_WEB_HOST=<staging-web-host>
XYGO_STAGING_API_HOST=<staging-api-host>
XYGO_STAGING_IDP_CALLBACK_URL=https://<staging-web-host>/auth/callback
XYGO_STAGING_IDP_LOGOUT_URL=https://<staging-web-host>/
XYGO_STAGING_INGRESS_FORWARDED_PROTO=https
XYGO_STAGING_TLS_MIN_VERSION=1.2
XYGO_STAGING_HSTS_MAX_AGE=31536000
XYGO_STAGING_CACHE_AUTHENTICATED=false
XYGO_STAGING_REDACT_AUTHORIZATION=true
XYGO_STAGING_REDACT_COOKIE=true
XYGO_STAGING_REDACT_QUERY_STRINGS=true

# Remote smoke inputs. Never save access tokens in this file.
XYGO_STAGING_BASE_URL=https://<staging-web-host>
XYGO_STAGING_EXPECTED_RELEASE=<immutable-release-id>
