# Production environment contract. Examples and placeholders only; this file is not deployable.
# Replace every <secret:...> value through the approved secret manager at process startup.

# Runtime posture (API, web, worker; never exposed by /runtime-config.json)
NODE_ENV=production
STAGED_MODE=false
XYGO_DEPLOY_ENVIRONMENT=production
XYGO_RELEASE=<immutable-release-id>

# Public browser/runtime values (safe allowlist for /runtime-config.json)
XYGO_WEB_APP_URL=https://app.xygo.example
XYGO_WEB_API_BASE_URL=https://api.xygo.example
XYGO_AUTH_MODE=oidc
XYGO_OIDC_PROVIDER=other-managed-oidc
XYGO_OIDC_ISSUER=https://tenant.example-idp.com/
XYGO_OIDC_AUDIENCE=https://api.xygo.example
XYGO_WEB_OIDC_CLIENT_ID=<public-client-id>
XYGO_WEB_OIDC_AUTHORIZATION_ENDPOINT=https://tenant.example-idp.com/authorize
XYGO_WEB_OIDC_TOKEN_ENDPOINT=https://tenant.example-idp.com/oauth/token
XYGO_WEB_OIDC_END_SESSION_ENDPOINT=https://tenant.example-idp.com/logout
XYGO_WEB_OIDC_SCOPES=openid profile email
XYGO_WEB_MONITORING_ENDPOINT=https://browser-monitoring.example.com/events

# API-only OIDC verification settings
XYGO_OIDC_JWKS_URI=https://tenant.example-idp.com/.well-known/jwks.json
XYGO_OIDC_ALLOWED_ALGORITHMS=RS256
XYGO_OIDC_CLOCK_TOLERANCE_SEC=60

# Private API/worker settings (must never be injected into browser code or public runtime config)
XYGO_API_REPOSITORY_MODE=postgres
XYGO_API_PG_URL=<secret:postgres-url-with-sslmode-verify-full>
XYGO_AUDIT_SIGNING_KEY=<secret:at-least-32-random-characters>

# Email contract (validation only in this slice)
XYGO_EMAIL_TRANSPORT=smtp
XYGO_EMAIL_FROM=notifications@xygo.example
XYGO_SMTP_HOST=smtp.example.com
XYGO_SMTP_PORT=465
XYGO_SMTP_USERNAME=<secret:smtp-username>
XYGO_SMTP_PASSWORD=<secret:at-least-16-random-characters>

# Object storage contract (validation only in this slice)
XYGO_STORAGE_DRIVER=s3
XYGO_STORAGE_BUCKET=xygo-production-uploads
XYGO_STORAGE_REGION=us-east-1
XYGO_STORAGE_ENDPOINT=https://object-storage.example.com
XYGO_STORAGE_ACCESS_KEY_ID=<secret:storage-access-key-id>
XYGO_STORAGE_SECRET_ACCESS_KEY=<secret:at-least-16-random-characters>

# Durable outbox/worker contract (validation only in this slice)
XYGO_OUTBOX_BACKEND=postgres
XYGO_WORKER_INTERVAL_MS=1000
XYGO_WORKER_MAX_ATTEMPTS=5
XYGO_WORKER_BASE_BACKOFF_MS=1000
XYGO_WORKER_CONCURRENCY=4

# Server-side monitoring contract (validation only in this slice)
XYGO_MONITORING_OTLP_ENDPOINT=https://telemetry.example.com/v1
XYGO_MONITORING_AUTH_TOKEN=<secret:at-least-16-random-characters>
